<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mad_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/btnVoltarListaAgendamentos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Voltar"
        android:textColor="@color/mad_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtTituloListaAgendamentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Agendamentos"
        android:textColor="@color/mad_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtResumoListaAgendamentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Histórico e confirmações"
        android:textColor="@color/mad_text_muted" />

    <TextView
        android:id="@+id/txtEstadoVazioAgendamentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_dark"
        android:padding="18dp"
        android:text="Carregando agendamentos..."
        android:textColor="@color/mad_text_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAgendamentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:paddingBottom="8dp" />
</LinearLayout>
