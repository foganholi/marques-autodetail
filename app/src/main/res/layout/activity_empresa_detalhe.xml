<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mad_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnVoltarDetalhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← Voltar"
            android:textColor="@color/mad_text"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_highlight"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtDetalheNomeEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marques AutoDetail"
                android:textColor="@color/mad_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalheEndereco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bela Vista • Av. Paulista"
                android:textColor="@color/mad_text_muted" />

            <TextView
                android:id="@+id/txtDetalheAvaliacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="★ 4.9"
                android:textColor="@color/mad_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalheDistancia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1,2 km"
                android:textColor="@color/mad_text_muted" />

            <TextView
                android:id="@+id/txtDetalheDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Descrição da empresa"
                android:textColor="@color/mad_text_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Serviços disponíveis"
            android:textColor="@color/mad_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerServicosEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
