<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mad_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".ui.CadastroActivity">

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textColor="@color/mad_text"
            android:backgroundTint="@color/mad_gray"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imgLogoCadastro"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnVoltar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtTituloCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_title"
            android:textColor="@color/mad_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogoCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtSubCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/mad_text_muted"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtTituloCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/name_hint"
            android:textColor="@android:color/black"
            android:textColorHint="#808080"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:minHeight="48dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/txtSubCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtEmailCadastro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/email_or_user_hint"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/black"
            android:textColorHint="#808080"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtNome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtSenhaCadastro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:textColor="@android:color/black"
            android:textColorHint="#808080"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtEmailCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edtConfirmarSenha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/confirm_password_hint"
            android:inputType="textPassword"
            android:textColor="@android:color/black"
            android:textColorHint="#808080"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
            android:minHeight="48dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/edtSenhaCadastro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtTipoConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de conta"
            android:textColor="@color/mad_text"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/radioGroupTipoConta"
            app:layout_constraintStart_toStartOf="parent" />

        <RadioGroup
            android:id="@+id/radioGroupTipoConta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtTipoConta"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/rbContaCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Cliente"
                android:textColor="@color/mad_text" />

            <RadioButton
                android:id="@+id/rbContaEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Empresa"
                android:textColor="@color/mad_text" />
        </RadioGroup>

        <TextView
            android:id="@+id/txtGenero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gender_label"
            android:textColor="@color/mad_text"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/edtConfirmarSenha"
            app:layout_constraintStart_toStartOf="parent" />

        <RadioGroup
            android:id="@+id/radioGroupGenero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtGenero"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/rbMasculino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/male_option"
                android:textColor="@color/mad_text" />

            <RadioButton
                android:id="@+id/rbFeminino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/female_option"
                android:textColor="@color/mad_text" />
        </RadioGroup>

        <TextView
            android:id="@+id/txtInteresse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/interests_label"
            android:textColor="@color/mad_text"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/radioGroupGenero"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/cbLavagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wash_option"
            android:textColor="@color/mad_text"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtInteresse"
            app:layout_constraintStart_toStartOf="parent" />

        <CheckBox
            android:id="@+id/cbPolimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/polish_option"
            android:textColor="@color/mad_text"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/cbLavagem"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtTipoVeiculo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_type_label"
            android:textColor="@color/mad_text"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/cbPolimento"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/spnVeiculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/txtTipoVeiculo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnCriarConta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/create_account_confirm_button"
            android:textColor="@color/mad_text"
            android:textStyle="bold"
            android:backgroundTint="@color/mad_primary"
            android:minHeight="48dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/spnVeiculo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>