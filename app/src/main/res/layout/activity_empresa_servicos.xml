<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mad_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/btnVoltarEmpresaServicos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Voltar"
        android:textColor="@color/mad_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Serviços da empresa"
        android:textColor="@color/mad_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStatusEmpresaServicos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Carregando serviços..."
        android:textColor="@color/mad_text_muted" />

    <Button
        android:id="@+id/btnNovoServicoEmpresa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/mad_primary"
        android:minHeight="52dp"
        android:text="+ Novo serviço"
        android:textColor="@color/mad_text"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEmpresaServicos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />
</LinearLayout>
