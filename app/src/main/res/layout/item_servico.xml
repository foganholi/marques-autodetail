<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtNomeServico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lavagem completa"
        android:textColor="@color/mad_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDescricaoServico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Lavagem externa e interna."
        android:textColor="@color/mad_text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPrecoServico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="R$ 80,00"
            android:textColor="@color/mad_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDuracaoServico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90 min"
            android:textColor="@color/mad_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAgendarServico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/mad_primary"
        android:minHeight="48dp"
        android:text="Agendar este serviço"
        android:textColor="@color/mad_text"
        android:textStyle="bold" />
</LinearLayout>
