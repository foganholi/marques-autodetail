<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mad_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/btnVoltarHorarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textColor="@color/mad_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Dias e horários"
            android:textColor="@color/mad_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHorariosStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Configure quando a empresa atende."
            android:textColor="@color/mad_text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="18dp">

            <Spinner
                android:id="@+id/spnDiaSemanaHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp" />

            <EditText
                android:id="@+id/edtHoraInicio"
                style="@style/MadInput"
                android:layout_marginTop="10dp"
                android:hint="Início. Ex: 08:00" />

            <EditText
                android:id="@+id/edtHoraFim"
                style="@style/MadInput"
                android:layout_marginTop="10dp"
                android:hint="Fim. Ex: 18:00" />

            <Button
                android:id="@+id/btnAdicionarHorario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/mad_primary"
                android:minHeight="52dp"
                android:text="Adicionar horário"
                android:textColor="@color/mad_text"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerHorariosEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
