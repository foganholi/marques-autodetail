<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mad_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/btnVoltarPerfilCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textColor="@color/mad_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_highlight"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil do cliente"
                android:textColor="@color/mad_bg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPerfilClienteNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Usuário"
                android:textColor="@color/mad_bg"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPerfilClienteEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="email@exemplo.com"
                android:textColor="@color/mad_bg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtPerfilClienteRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Conta: Cliente"
                android:textColor="@color/mad_bg"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPerfilHistorico"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/mad_primary"
            android:text="Ver histórico de agendamentos"
            android:textColor="@color/mad_bg"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPerfilFavoritos"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/mad_surface_2"
            android:text="Empresas favoritas"
            android:textColor="@color/mad_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPerfilSair"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/mad_gray"
            android:text="Sair da conta"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
